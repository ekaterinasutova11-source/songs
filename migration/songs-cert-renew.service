[Unit]
Description=Renew Songs HTTPS certificate
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=/opt/certbot/bin/certbot renew --quiet --deploy-hook "/usr/sbin/nginx -t && /bin/systemctl reload nginx"
Restart=on-failure
RestartSec=300
